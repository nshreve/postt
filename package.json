{
  "name": "postt",
  "version": "0.1.1",
  "description": "A delightful CLI for creating and publishing blogs",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "author": "Noah Shreve",
  "repository": {
    "type": "git",
    "url": "https://github.com/nshreve/postt"
  },
  "keywords": [
    "cli",
    "blog",
    "markdown",
    "terminal"
  ],
  "license": "MIT",
  "dependencies": {
    "cfonts": "^3.3.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^12.0.0",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "marked": "^12.0.1",
    "open": "^10.1.0",
    "ora": "^8.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
